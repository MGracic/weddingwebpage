---
import { getLangFromUrl, useTranslations } from "../i18n/utils";

interface Props {
  sectionTitle: string;
}

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const { sectionTitle } = Astro.props;
---

<section class="max-w-3xl mx-auto px-4 py-24 text-center">
  <h1 class="font-serif text-4xl sm:text-5xl text-charcoal mb-4">{sectionTitle}</h1>
  <div class="w-16 h-px bg-bronze mx-auto mb-8"></div>
  <p class="text-charcoal-light text-lg">{t("coming-soon.description")}</p>
  <div class="mt-8">
    <svg class="w-16 h-16 mx-auto text-warm" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1">
      <path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 11-18 0 9 9 0 0118 0z" />
    </svg>
  </div>
</section>
