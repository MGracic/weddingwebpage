---
import Layout from "../../layouts/Layout.astro";
import RsvpForm from "../../components/RsvpForm.astro";
import { useTranslations } from "../../i18n/utils";

const t = useTranslations("en");
---

<Layout title={`${t("rsvp.title")} — Tea & Mak`}>
  <section class="max-w-3xl mx-auto px-4 py-24">
    <h1 class="font-serif text-4xl sm:text-5xl text-charcoal mb-4 text-center">{t("rsvp.title")}</h1>
    <div class="w-16 h-px bg-bronze mx-auto mb-4"></div>
    <p class="text-center text-charcoal-light mb-12">{t("rsvp.description")}</p>
    <RsvpForm />
  </section>
</Layout>
