---
import Layout from "../layouts/Layout.astro";
import { useTranslations } from "../i18n/utils";

const t = useTranslations("hr");
---

<Layout title={`${t("details.title")} — Tea i Mak`}>
  <section class="max-w-3xl mx-auto px-4 py-24">
    <h1 class="font-serif text-4xl sm:text-5xl text-charcoal mb-4 text-center">{t("details.title")}</h1>
    <div class="w-16 h-px bg-bronze mx-auto mb-12"></div>

    <div class="grid sm:grid-cols-2 gap-8">
      <!-- When -->
      <div class="bg-cream rounded-lg p-8 text-center">
        <h2 class="font-serif text-2xl text-bronze mb-3">{t("details.when")}</h2>
        <p class="text-charcoal text-lg">{t("details.date")}</p>
      </div>

      <!-- Where -->
      <div class="bg-cream rounded-lg p-8 text-center">
        <h2 class="font-serif text-2xl text-bronze mb-3">{t("details.where")}</h2>
        <p class="text-charcoal-light text-lg">{t("details.venue")}</p>
      </div>

      <!-- Schedule -->
      <div class="bg-cream rounded-lg p-8 text-center sm:col-span-2">
        <h2 class="font-serif text-2xl text-bronze mb-6">{t("details.schedule")}</h2>
        <div class="flex flex-col sm:flex-row justify-center gap-6 sm:gap-12">
          <div>
            <p class="text-bronze font-medium text-lg">{t("details.gathering.time")}</p>
            <p class="text-charcoal-light">{t("details.gathering")}</p>
          </div>
          <div>
            <p class="text-bronze font-medium text-lg">{t("details.ceremony.time")}</p>
            <p class="text-charcoal-light">{t("details.ceremony")}</p>
          </div>
          <div>
            <p class="text-bronze font-medium text-lg">{t("details.reception.time")}</p>
            <p class="text-charcoal-light">{t("details.reception")}</p>
          </div>
        </div>
      </div>

      <!-- Dress code -->
      <div class="bg-cream rounded-lg p-8 text-center sm:col-span-2">
        <h2 class="font-serif text-2xl text-bronze mb-3">{t("details.dresscode")}</h2>
        <p class="text-charcoal-light text-lg">{t("details.dresscode.desc")}</p>
      </div>

      <!-- Spotify playlist -->
      <div class="bg-cream rounded-lg p-8 text-center sm:col-span-2">
        <h2 class="font-serif text-2xl text-bronze mb-6">{t("details.playlist")}</h2>
        <iframe
          style="border-radius:12px"
          src="https://open.spotify.com/embed/playlist/2TeWrDJ2pKTTNO11xaBQin?utm_source=generator&theme=0"
          width="100%"
          height="352"
          frameborder="0"
          allowfullscreen=""
          allow="autoplay; clipboard-write; encrypted-media; fullscreen; picture-in-picture"
          loading="lazy"
        ></iframe>
      </div>
    </div>
  </section>
</Layout>
