---
import { getLangFromUrl, useTranslations } from "../i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<form id="rsvp-form" class="max-w-lg mx-auto space-y-6"
  data-t-add-guest={t("rsvp.add-guest")}
  data-t-remove={t("rsvp.remove-guest")}
  data-t-additional={t("rsvp.additional-guest")}
  data-t-guest-name={t("rsvp.guest-name")}
  data-t-guest-name-ph={t("rsvp.guest-name.placeholder")}
  data-t-guest-dietary-ph={t("rsvp.guest-dietary.placeholder")}
  data-t-dietary={t("rsvp.dietary")}
>
  <!-- Name -->
  <div>
    <label for="name" class="block text-sm font-medium text-charcoal mb-1">
      {t("rsvp.name")} <span class="text-bronze">*</span>
    </label>
    <input
      type="text"
      id="name"
      name="name"
      required
      placeholder={t("rsvp.name.placeholder")}
      class="w-full px-4 py-3 bg-white border border-warm rounded-md focus:outline-none focus:ring-2 focus:ring-bronze/30 focus:border-bronze transition-colors"
    />
  </div>

  <!-- Attending -->
  <fieldset>
    <legend class="block text-sm font-medium text-charcoal mb-3">
      {t("rsvp.attending")} <span class="text-bronze">*</span>
    </legend>
    <div class="flex gap-4">
      <label class="flex-1 cursor-pointer">
        <input type="radio" name="attending" value="yes" required class="peer sr-only" />
        <div class="text-center py-3 px-4 border border-warm rounded-md peer-checked:border-sage-dark peer-checked:bg-sage/20 peer-checked:text-sage-dark transition-colors hover:border-sage">
          {t("rsvp.attending.yes")}
        </div>
      </label>
      <label class="flex-1 cursor-pointer">
        <input type="radio" name="attending" value="no" required class="peer sr-only" />
        <div class="text-center py-3 px-4 border border-warm rounded-md peer-checked:border-bronze peer-checked:bg-bronze/10 peer-checked:text-bronze transition-colors hover:border-bronze-light">
          {t("rsvp.attending.no")}
        </div>
      </label>
    </div>
  </fieldset>

  <!-- Conditional fields (shown when attending=yes) -->
  <div id="attending-fields" class="hidden space-y-6">

    <!-- Primary guest dietary -->
    <div>
      <label for="dietary" class="block text-sm font-medium text-charcoal mb-1">
        {t("rsvp.dietary")}
      </label>
      <input
        type="text"
        id="dietary"
        name="dietary"
        placeholder={t("rsvp.dietary.placeholder")}
        class="w-full px-4 py-3 bg-white border border-warm rounded-md focus:outline-none focus:ring-2 focus:ring-bronze/30 focus:border-bronze transition-colors"
      />
    </div>

    <!-- Additional guests container -->
    <div id="guests-container" class="space-y-4"></div>

    <!-- Add guest button -->
    <button
      type="button"
      id="add-guest-btn"
      class="w-full py-3 px-4 border-2 border-dashed border-warm rounded-md text-charcoal-light hover:border-bronze hover:text-bronze transition-colors flex items-center justify-center gap-2"
    >
      <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" />
      </svg>
      {t("rsvp.add-guest")}
    </button>

    <!-- Accommodation -->
    <fieldset>
      <legend class="block text-sm font-medium text-charcoal mb-3">
        {t("rsvp.accommodation")}
      </legend>
      <div class="flex gap-4">
        <label class="flex-1 cursor-pointer">
          <input type="radio" name="accommodation" value="yes" class="peer sr-only" />
          <div class="text-center py-3 px-4 border border-warm rounded-md peer-checked:border-sage-dark peer-checked:bg-sage/20 peer-checked:text-sage-dark transition-colors hover:border-sage text-sm">
            {t("rsvp.accommodation.yes")}
          </div>
        </label>
        <label class="flex-1 cursor-pointer">
          <input type="radio" name="accommodation" value="no" class="peer sr-only" />
          <div class="text-center py-3 px-4 border border-warm rounded-md peer-checked:border-bronze peer-checked:bg-bronze/10 peer-checked:text-bronze transition-colors hover:border-bronze-light text-sm">
            {t("rsvp.accommodation.no")}
          </div>
        </label>
      </div>
    </fieldset>

    <!-- Song request -->
    <div>
      <label for="song" class="block text-sm font-medium text-charcoal mb-1">
        {t("rsvp.song")}
      </label>
      <input
        type="text"
        id="song"
        name="song"
        placeholder={t("rsvp.song.placeholder")}
        class="w-full px-4 py-3 bg-white border border-warm rounded-md focus:outline-none focus:ring-2 focus:ring-bronze/30 focus:border-bronze transition-colors"
      />
    </div>
  </div>

  <!-- Message (always shown) -->
  <div>
    <label for="message" class="block text-sm font-medium text-charcoal mb-1">
      {t("rsvp.message")}
    </label>
    <textarea
      id="message"
      name="message"
      rows="3"
      placeholder={t("rsvp.message.placeholder")}
      class="w-full px-4 py-3 bg-white border border-warm rounded-md focus:outline-none focus:ring-2 focus:ring-bronze/30 focus:border-bronze transition-colors resize-none"
    ></textarea>
  </div>

  <!-- Submit -->
  <button
    type="submit"
    id="rsvp-submit"
    class="w-full py-3 px-6 bg-bronze text-white rounded-md hover:bg-bronze-light transition-colors font-medium tracking-wide"
  >
    {t("rsvp.submit")}
  </button>

  <!-- Status messages -->
  <p id="rsvp-success" class="hidden text-center text-sage-dark font-medium py-2">
    {t("rsvp.success")}
  </p>
  <p id="rsvp-error" class="hidden text-center text-red-600 font-medium py-2">
    {t("rsvp.error")}
  </p>
</form>

<script>
  const form = document.getElementById("rsvp-form") as HTMLFormElement | null;
  if (!form) throw new Error("Form not found");

  // Read translated strings from data attributes
  const T = {
    remove: form.dataset.tRemove ?? "Remove",
    additional: form.dataset.tAdditional ?? "Additional guest",
    guestName: form.dataset.tGuestName ?? "Full Name",
    guestNamePh: form.dataset.tGuestNamePh ?? "Guest's full name",
    guestDietaryPh: form.dataset.tGuestDietaryPh ?? "Dietary requirements (if any)",
    dietary: form.dataset.tDietary ?? "Dietary Requirements",
  };

  // Progressive disclosure: show/hide fields based on attendance
  const radios = document.querySelectorAll<HTMLInputElement>('input[name="attending"]');
  const attendingFields = document.getElementById("attending-fields");

  radios.forEach((radio) => {
    radio.addEventListener("change", () => {
      if (radio.value === "yes") {
        attendingFields?.classList.remove("hidden");
      } else {
        attendingFields?.classList.add("hidden");
      }
    });
  });

  // Dynamic guest management
  const guestsContainer = document.getElementById("guests-container");
  const addGuestBtn = document.getElementById("add-guest-btn");
  let guestCount = 0;

  function addGuest() {
    guestCount++;
    const n = guestCount;

    const card = document.createElement("div");
    card.id = `guest-${n}`;
    card.className = "bg-cream rounded-lg p-4 space-y-3 relative";

    card.innerHTML = `
      <div class="flex items-center justify-between mb-1">
        <span class="text-sm font-medium text-charcoal">${T.additional} #${n}</span>
        <button type="button" class="remove-guest-btn text-xs text-charcoal-light hover:text-red-600 transition-colors" data-guest="${n}">
          ${T.remove} &times;
        </button>
      </div>
      <div>
        <label for="guest-name-${n}" class="block text-xs text-charcoal-light mb-1">${T.guestName}</label>
        <input
          type="text"
          id="guest-name-${n}"
          name="guest_${n}_name"
          placeholder="${T.guestNamePh}"
          class="w-full px-3 py-2 bg-white border border-warm rounded-md focus:outline-none focus:ring-2 focus:ring-bronze/30 focus:border-bronze transition-colors text-sm"
        />
      </div>
      <div>
        <label for="guest-dietary-${n}" class="block text-xs text-charcoal-light mb-1">${T.dietary}</label>
        <input
          type="text"
          id="guest-dietary-${n}"
          name="guest_${n}_dietary"
          placeholder="${T.guestDietaryPh}"
          class="w-full px-3 py-2 bg-white border border-warm rounded-md focus:outline-none focus:ring-2 focus:ring-bronze/30 focus:border-bronze transition-colors text-sm"
        />
      </div>
    `;

    guestsContainer?.appendChild(card);

    card.querySelector(".remove-guest-btn")?.addEventListener("click", () => {
      card.remove();
      renumberGuests();
    });
  }

  function renumberGuests() {
    const cards = guestsContainer?.querySelectorAll("[id^='guest-']") ?? [];
    cards.forEach((card, i) => {
      const num = i + 1;
      const label = card.querySelector("span");
      if (label) label.textContent = `${T.additional} #${num}`;
    });
    guestCount = cards.length;
  }

  addGuestBtn?.addEventListener("click", addGuest);

  // Form submission
  const submitBtn = document.getElementById("rsvp-submit") as HTMLButtonElement | null;
  const successMsg = document.getElementById("rsvp-success");
  const errorMsg = document.getElementById("rsvp-error");

  // TODO: Replace with your Google Apps Script web app URL
  const APPS_SCRIPT_URL = "";

  form.addEventListener("submit", async (e) => {
    e.preventDefault();
    if (!submitBtn) return;

    successMsg?.classList.add("hidden");
    errorMsg?.classList.add("hidden");

    const originalText = submitBtn.textContent;
    submitBtn.disabled = true;
    submitBtn.textContent = submitBtn.dataset.sending ?? "...";

    // Collect form data including dynamic guest fields
    const formData = new FormData(form);

    // Gather additional guests into a structured format
    const guests: { name: string; dietary: string }[] = [];
    const guestCards = guestsContainer?.querySelectorAll("[id^='guest-']") ?? [];
    guestCards.forEach((_, i) => {
      const name = (formData.get(`guest_${i + 1}_name`) as string) ?? "";
      const dietary = (formData.get(`guest_${i + 1}_dietary`) as string) ?? "";
      if (name.trim()) guests.push({ name, dietary });
    });

    // Build submission data
    const data: Record<string, string> = {
      name: (formData.get("name") as string) ?? "",
      attending: (formData.get("attending") as string) ?? "",
      dietary: (formData.get("dietary") as string) ?? "",
      accommodation: (formData.get("accommodation") as string) ?? "",
      song: (formData.get("song") as string) ?? "",
      message: (formData.get("message") as string) ?? "",
      guestCount: String(guests.length),
      guests: JSON.stringify(guests),
    };

    try {
      if (!APPS_SCRIPT_URL) {
        await new Promise((r) => setTimeout(r, 800));
      } else {
        await fetch(APPS_SCRIPT_URL, {
          method: "POST",
          mode: "no-cors",
          headers: { "Content-Type": "application/x-www-form-urlencoded" },
          body: new URLSearchParams(data),
        });
      }
      form.reset();
      guestsContainer!.innerHTML = "";
      guestCount = 0;
      attendingFields?.classList.add("hidden");
      successMsg?.classList.remove("hidden");
    } catch {
      errorMsg?.classList.remove("hidden");
    } finally {
      submitBtn.disabled = false;
      submitBtn.textContent = originalText;
    }
  });
</script>
